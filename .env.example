# Mirrors the env var table in README.md — copy to .env if your agent config reads one,
# or set these directly in your MCP server registration (see README "Install").

# USB address (10.0.4.20 with no setup needed) or the bar's Wi-Fi IP.
BUSYBAR_HOST=10.0.4.20

# 4-10 digit PIN access key. Only enforced over Wi-Fi, not USB. Leave unset for USB-only use.
BUSYBAR_TOKEN=

# Default application_name used for draws and asset uploads when not specified per-call.
BUSYBAR_APP=mcp-scratch
